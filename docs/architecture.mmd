flowchart LR
    IN["Power App export<br/>(synthetic)<br/>app.pa.yaml · flow.json<br/>dataverse-schema.json"]

    subgraph T["TRANSFORM"]
        EXT["Extractor<br/>code parses rules"]
        EXTLLM(["LLM: rule sentence<br/>+ confidence"])
        REG[("Rule register<br/>11 rules · 2 unsupported")]
    end

    GATE{{"HUMAN GATE<br/>approve / reject"}}

    subgraph R["REBUILD"]
        GEN["Generator<br/>templates · precedence"]
        GENLLM(["LLM: one method<br/>body per rule"])
        APPOUT["Migrated app<br/>.NET 8 API · Rules/R01–R11<br/>Cosmos model · React form"]
    end

    subgraph V["VERIFY"]
        CASES[("Reference cases (32)<br/>confirmed by Power Fx engine<br/>hash-guarded")]
        JUDGE["Parity Court<br/>run API · compare<br/>field by field"]
        REPAIR["Repair loop<br/>max 3 · Rules/ only"]
        REPLLM(["LLM: patch for<br/>one rule file"])
    end

    OUT["Evidence + dashboard<br/>parity · repairs · evidence.md<br/>Transform · Rebuild · Verify"]

    IN --> EXT
    EXT --> REG
    EXTLLM -. wording only .-> REG
    REG --> GATE
    GATE -- approved only --> GEN
    GENLLM -. bodies .-> GEN
    GEN --> APPOUT
    APPOUT --> JUDGE
    CASES --> JUDGE
    JUDGE -- mismatch --> REPAIR
    REPLLM -. patch .-> REPAIR
    REPAIR -- re-judge --> JUDGE
    JUDGE --> OUT

    classDef llm fill:#fff4d6,stroke:#b7791f,color:#5f370e
    classDef nollm fill:#e8f1fb,stroke:#2b6cb0,color:#1a365d
    classDef human fill:#e6f6ec,stroke:#2f855a,color:#1c4532,stroke-width:3px
    classDef data fill:#f4f4f5,stroke:#71717a,color:#27272a
    class EXTLLM,GENLLM,REPLLM llm
    class EXT,GEN,JUDGE,REPAIR,APPOUT,OUT nollm
    class GATE human
    class REG,CASES,IN data
